@model InventoryViewModel
<section class="hero">
  <div class="hero-card">
    <h1>Inventory</h1><p>Compare vehicles by model, price, and mileage.</p>
    <a class="button button-primary" href="/cars/new">Add a new car</a>
  </div>
  <div class="stats"><div class="stat"><strong>@Model.TotalCount</strong><span>Total listings</span></div>
  <div class="stat"><strong>@Model.Cars.Count</strong><span>Matching listings</span></div></div>
</section>
<form class="filter-bar" action="/cars" method="get">
  <div class="form-field"><label for="Search">Model</label><input id="Search" name="Search" value="@Model.Filter.Search" maxlength="120" /></div>
  <div class="form-field"><label for="MaxPrice">Maximum price (USD)</label><input id="MaxPrice" name="MaxPrice" value="@Model.Filter.MaxPrice" type="number" min="0" /></div>
  <div class="form-field"><label for="MaxMiles">Maximum mileage</label><input id="MaxMiles" name="MaxMiles" value="@Model.Filter.MaxMiles" type="number" min="0" /></div>
  <div class="form-field"><label for="Sort">Sort</label><select id="Sort" name="Sort">
    <option value="newest" selected="@(Model.Filter.Sort == "newest")">Newest first</option>
    <option value="model" selected="@(Model.Filter.Sort == "model")">Model A–Z</option>
    <option value="price" selected="@(Model.Filter.Sort == "price")">Lowest price</option>
    <option value="price-desc" selected="@(Model.Filter.Sort == "price-desc")">Highest price</option>
    <option value="miles" selected="@(Model.Filter.Sort == "miles")">Lowest mileage</option>
  </select></div>
  <button class="button button-primary" type="submit">Apply filters</button><a href="/cars">Clear</a>
</form>
@Html.ValidationSummary(false, "", new { @class = "validation-errors", role = "alert" })
@if (Model.Cars.Count == 0)
{
  <div class="empty-state"><p>No matching cars. Clear the filters or add a listing.</p></div>
}
else
{
  <section class="card-grid">
  @foreach (var car in Model.Cars)
  {
    <article class="car-card" data-listing-id="@car.Id">
      <span class="badge">#@car.Id</span><h2>@car.CarModel</h2>
      <div class="car-meta"><span>@car.Price.ToString("C0", CultureInfo.GetCultureInfo("en-US"))</span><span>@car.Miles.ToString("N0") miles</span></div>
      <div class="car-actions">
        <a class="button button-secondary" href="/cars/@car.Id">View</a>
        <a class="button button-secondary" href="/cars/@car.Id/edit">Edit</a>
        <a class="button button-secondary" href="/cars/@car.Id/delete">Delete</a>
      </div>
    </article>
  }
  </section>
}
