@model CarForm
<section class="hero"><div class="hero-card"><h1>Add a new car</h1><p>Enter the model, price in whole US dollars, and mileage.</p></div></section>
<form class="form-card" action="/cars" method="post">
  @Html.AntiForgeryToken()
  @Html.ValidationSummary(false, "", new { @class = "validation-errors", role = "alert" })
  <div class="form-grid">
    <div class="form-field">
      @Html.LabelFor(m => m.CarModel, "Car model")
      @Html.TextBoxFor(m => m.CarModel, new { required = "required", maxlength = 120 })
      <div class="form-help">Example: 2019 Subaru Forester</div>
    </div>
    <div class="form-field">
      @Html.LabelFor(m => m.Price, "Price (USD)")
      @Html.TextBoxFor(m => m.Price, new { type = "number", min = 0, max = int.MaxValue, step = 1, required = "required" })
    </div>
    <div class="form-field">
      @Html.LabelFor(m => m.Miles, "Mileage")
      @Html.TextBoxFor(m => m.Miles, new { type = "number", min = 0, max = int.MaxValue, step = 1, required = "required" })
    </div>
  </div>
  <div class="inline-actions">
    <button class="button button-primary" type="submit">Create listing</button>
    <a class="button button-secondary" href="/cars">Cancel</a>
  </div>
</form>
