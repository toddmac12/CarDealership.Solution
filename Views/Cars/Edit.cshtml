@using CarDealership.Models;

<section class="hero">
  <div class="hero-card">
    <h1>Edit listing</h1>
    <p>Update the model name, price, or mileage to keep the listing current.</p>
  </div>
</section>

<form class="form-card" action="/cars/@Model.Id" method="post">
  <div class="form-grid">
    <div class="form-field">
      <label for="carModel">Car model</label>
      <input id="carModel" name="carModel" type="text" value="@Model.CarModel" required />
    </div>
    <div class="form-field">
      <label for="price">Price</label>
      <input id="price" name="price" type="number" min="0" step="1" value="@Model.Price" required />
    </div>
    <div class="form-field">
      <label for="miles">Miles</label>
      <input id="miles" name="miles" type="number" min="0" step="1" value="@Model.Miles" required />
    </div>
  </div>
  <div class="inline-actions">
    <button class="button button-primary" type="submit">Save changes</button>
    <a class="button button-secondary" href="/cars/@Model.Id">Cancel</a>
  </div>
</form>
