<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Car Dealership</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
  <div class="bg-orb bg-orb--one"></div>
  <div class="bg-orb bg-orb--two"></div>
  <header class="site-header">
    <div class="site-brand">
      <span class="brand-mark">CD</span>
      <div>
        <p class="brand-title">Car Dealership</p>
        <p class="brand-subtitle">Curated rides, transparent prices</p>
      </div>
    </div>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/cars">Inventory</a>
      <a class="nav-cta" href="/cars/new">Add a Car</a>
    </nav>
  </header>
  <main class="page">
    @RenderBody()
  </main>
  <footer class="site-footer">
    <p>Local deals. Real stories. Built for the next drive.</p>
  </footer>
</body>
</html>
